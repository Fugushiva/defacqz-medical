# ============================================================
# Defacqz Medical Center 125 — Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ============================================================

# ----- Server-side (never expose to client) -----

# Resend API key for transactional email (contact form)
# Get yours at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email address that receives contact form submissions
CONTACT_EMAIL_TO=contact@defacqz-medical.be

# Canonical site URL (server-side, no trailing slash)
SITE_URL=https://defacqz-medical.vercel.app

# ----- Public (safe to expose to browser) -----

# Canonical site URL (public, used in client components)
# Must match SITE_URL — no trailing slash
NEXT_PUBLIC_SITE_URL=https://defacqz-medical.vercel.app
